# ==============================================================================
# NetDevOps Closed-Loop Automation Environment Configuration
# ==============================================================================

# Fortinet FortiGate Appliance Configuration
FORTIGATE_HOST=192.168.1.99
FORTIGATE_REST_PORT=8443
FORTIGATE_API_TOKEN=your_fortios_rest_api_token_here
FORTIGATE_SSH_USER=admin_remediation
FORTIGATE_SSH_PASSWORD=your_secure_ssh_password_or_key

# NetBox Single Source of Truth (SSoT) Configuration
NETBOX_URL=https://netbox.infra.arte.internal
NETBOX_API_TOKEN=your_netbox_api_token_here

# PRTG Network Monitor & Webhook Integration
PRTG_HOST=https://prtg.infra.arte.internal
PRTG_WEBHOOK_SECRET=your_prtg_webhook_secret_key

# Observability & Audit Trail Storage
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=supersecurepassword
MONGO_URI=mongodb://admin:supersecurepassword@localhost:27017/netdevops_audit?authSource=admin

# n8n Orchestrator Configuration
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_secure_password
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/

# Notification Endpoints (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_optional
TELEGRAM_CHAT_ID=your_telegram_chat_id_optional
